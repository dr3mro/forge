#!/usr/bin/env bash
# shellcheck disable=SC2034  # runtime globals are consumed by sourced modules
# Forge — entry point.
# Enforces Bash 4+, resolves the installation root, loads modules, dispatches.
# No side effects beyond bootstrapping; all logic lives in lib/.

set -o pipefail

FORGE_VERSION="0.1.0"

# --- Bash 4+ enforcement ---------------------------------------------------
if (( BASH_VERSINFO[0] < 4 )); then
  printf 'forge: Bash 4+ is required (found %s).\n' "$BASH_VERSION" >&2
  if [[ "$(uname -s)" == "Darwin" ]]; then
    cat >&2 <<'HINT'
macOS ships Bash 3.2. Install a modern Bash and put it first on PATH:

  brew install bash
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

Then run: forge ...
HINT
  fi
  exit 3
fi

# Follow the installed launcher symlink before looking for adjacent libraries.
_forge_entry="${BASH_SOURCE[0]}"
_forge_links=0
while [[ -L "${_forge_entry}" ]]; do
  if (( ++_forge_links > 40 )); then
    printf 'forge: too many launcher symlinks\n' >&2
    exit 1
  fi
  _forge_target=$(readlink "${_forge_entry}") || exit 1
  case "${_forge_target}" in
    /*) _forge_entry="${_forge_target}" ;;
    *) _forge_entry="$(dirname -- "${_forge_entry}")/${_forge_target}" ;;
  esac
done
_FORGE_BIN_DIR=$(cd -- "$(dirname -- "${_forge_entry}")" && pwd -P) || exit 1
FORGE_HOME=$(cd -- "${_FORGE_BIN_DIR}/.." && pwd -P)
export FORGE_HOME FORGE_VERSION

# Runtime defaults (overridable by CLI flags / environment).
FORGE_QUIET=0
FORGE_VERBOSE=0
FORGE_NO_COLOR=0
FORGE_FORCE_COLOR=0
FORGE_DRY_RUN=0
FORGE_OFFLINE=0
FORGE_YES=0
FORGE_MANIFEST_PATH=""
FORGE_ROOT=""
FORGE_EXTRA_CMAKE_ARGS=()
FORGE_SANITIZER=""
FORGE_CLEAN_FIRST=0
FORGE_LINK_COMPILE_COMMANDS=0

# Module loader; sources every module with no source-time side effects.
# shellcheck source=../lib/_load.sh
if ! source "${FORGE_HOME}/lib/_load.sh"; then
  printf 'forge: failed to load libraries from %s\n' "${FORGE_HOME}/lib" >&2
  exit 1
fi

# Close any active step and clean up registered temp directories on exit.
trap 'exit 143' TERM
trap 'progress_finish "$?"; forge_cleanup_tmpdirs' EXIT
forge_main "$@"
