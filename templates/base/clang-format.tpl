# Formatting rules for Forge-generated C/C++ projects.
# Adapted from the Valhalla-server project (.clang-format).
# See https://clang.llvm.org/docs/ClangFormatStyleOptions.html
---
BasedOnStyle: LLVM
ColumnLimit: 80
IndentWidth: 2
UseTab: Never
PointerAlignment: Right
ReferenceAlignment: Pointer
DerivePointerAlignment: false
