# Generated by Forge. This workflow and .github/forge/ are user-owned.
name: Forge CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  linux:
    runs-on: ubuntu-24.04
    strategy:
      fail-fast: false
      matrix:
        config: [Debug, Release]
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Prepare dependency inputs
        run: python .github/forge/ci.py prepare
      - uses: docker/setup-buildx-action@v3
      - name: Build dependency image
        id: deps-image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: .github/forge/Dockerfile
          target: deps
          build-args: CONFIG=${{ matrix.config }}
          tags: forge-deps:${{ matrix.config }}
          provenance: false
          outputs: type=oci,dest=${{ runner.temp }}/deps-image.tar
          cache-from: type=gha,scope=forge-linux-deps-${{ matrix.config }}
          cache-to: type=gha,scope=forge-linux-deps-${{ matrix.config }},mode=max,ignore-error=true
      - name: Stage dependency image for the project build
        shell: bash
        run: |
          mkdir -p "${RUNNER_TEMP}/deps-image"
          tar -xf "${RUNNER_TEMP}/deps-image.tar" -C "${RUNNER_TEMP}/deps-image"
      - name: Build project image and run tests
        uses: docker/build-push-action@v6
        with:
          context: .
          file: .github/forge/Dockerfile
          target: project
          build-args: |
            CONFIG=${{ matrix.config }}
            DEPENDENCY_IMAGE=ci-dependency-image
          build-contexts: ci-dependency-image=oci-layout://${{ runner.temp }}/deps-image@${{ steps.deps-image.outputs.digest }}
          tags: forge-project:${{ matrix.config }}
          outputs: type=docker,dest=${{ runner.temp }}/project-image.tar
          cache-from: type=gha,scope=forge-linux-project-${{ matrix.config }}
          cache-to: type=gha,scope=forge-linux-project-${{ matrix.config }},mode=max,ignore-error=true
      - name: Extract tested project artifacts
        shell: bash
        env:
          FORGE_CONFIG: ${{ matrix.config }}
        run: |
          docker load --input "${RUNNER_TEMP}/project-image.tar"
          container=$(docker create "forge-project:${FORGE_CONFIG}" true)
          trap 'docker rm "$container" >/dev/null' EXIT
          mkdir -p target/forge-ci-artifacts
          docker cp "${container}:/project/target/forge-ci-artifacts/." target/forge-ci-artifacts/
          gzip "${RUNNER_TEMP}/project-image.tar"
      - uses: actions/upload-artifact@v4
        with:
          name: Linux-deps-image-${{ matrix.config }}
          path: ${{ runner.temp }}/deps-image.tar
          compression-level: 0
          if-no-files-found: error
      - uses: actions/upload-artifact@v4
        with:
          name: Linux-${{ matrix.config }}
          path: target/forge-ci-artifacts/project-*.tar.gz
          if-no-files-found: error
      - uses: actions/upload-artifact@v4
        with:
          name: Linux-image-${{ matrix.config }}
          path: ${{ runner.temp }}/project-image.tar.gz
          if-no-files-found: error

  native:
    strategy:
      fail-fast: false
      matrix:
        os: [windows-2022, macos-15]
        config: [Debug, Release]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install Conan
        run: python -m pip install conan==2.33.0
      - name: Prepare dependency inputs
        run: python .github/forge/ci.py prepare
      - name: Cache native dependencies
        id: deps
        uses: actions/cache@v4
        with:
          path: target/forge-ci-deps
          key: forge-${{ matrix.os }}-${{ runner.arch }}-${{ matrix.config }}-${{ hashFiles('target/forge-ci-inputs/*', '.github/forge/ci.py', '.github/workflows/forge.yml') }}
      - name: Build or fetch dependencies
        if: steps.deps.outputs.cache-hit != 'true'
        run: python .github/forge/ci.py deps --config ${{ matrix.config }}
      - name: Build and test
        run: python .github/forge/ci.py build --config ${{ matrix.config }}
      - uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.os }}-${{ matrix.config }}
          path: target/forge-ci-artifacts/project-*.tar.gz
          if-no-files-found: error
