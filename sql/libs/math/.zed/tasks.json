[
  {
    "label": "Forge: Build",
    "command": "forge",
    "args": [
      "build"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Forge: Test",
    "command": "forge",
    "args": [
      "test"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Forge: Debug build",
    "command": "forge",
    "args": [
      "build",
      "--debug-target",
      "math_tests"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
